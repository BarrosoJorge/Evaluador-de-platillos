# Etapa 1: Builder - compilación optimizada
FROM ubuntu:22.04 AS builder

# Instalar dependencias de compilación
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    libopencv-dev \
    python3-opencv \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Crear directorio de trabajo
WORKDIR /build

# Copiar archivos fuente
COPY VideoLabeler.cpp .
COPY CMakeLists.txt .

# Compilar en modo Release para optimización
RUN cmake -DCMAKE_BUILD_TYPE=Release . && \
    cmake --build . --config Release -- -j$(nproc)

# ============================================================================

# Etapa 2: Runtime - imagen mínima para ejecución
FROM ubuntu:22.04

# Instalar solo dependencias de runtime necesarias
RUN apt-get update && apt-get install -y \
    libopencv-core4.5 \
    libopencv-videoio4.5 \
    libopencv-highgui4.5 \
    libgomp1 \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Crear usuario no-root para seguridad
RUN useradd -m -u 1000 video_user

# Crear directorio de datos
WORKDIR /home/video_user/data
RUN chown -R video_user:video_user /home/video_user

# Copiar binario compilado desde builder
COPY --from=builder --chown=video_user:video_user /build/video_labeler /usr/local/bin/video_labeler

# Cambiar a usuario no-root
USER video_user

# Volumen para montaje de datos
VOLUME ["/home/video_user/data"]

# Directorio de trabajo por defecto
WORKDIR /home/video_user/data

# Ejecutar aplicación
ENTRYPOINT ["video_labeler"]